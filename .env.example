# Single instance (registered as instance "default")
FRESHRSS_URL=https://your-freshrss-instance.com
FRESHRSS_EMAIL=your-username
FRESHRSS_API_PASSWORD=your-api-password

# Multiple instances: JSON file, default ~/.config/freshrss-mcp/instances.json
# FRESHRSS_CONFIG=/path/to/instances.json
# Instance to start on (default: first configured)
# FRESHRSS_INSTANCE=default

# LOG_LEVEL=INFO
